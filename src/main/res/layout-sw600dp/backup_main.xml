<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mainRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_marginBottom="85dp"
            android:layout_weight="0.42">

        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:fadingEdge="horizontal|vertical">

        <ListView
            android:id="@+id/listView1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="85dp"
            android:background="#FFFFFF" />

        <EditText
            android:id="@+id/backup_main_textView"
            android:layout_width="match_parent"
            android:layout_height="41dp"
            android:layout_above="@+id/button_backup_start"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:background="#e6e6e6"
            android:clickable="false"
            android:contentDescription="@string/main_text_area_to_explain_what_this_app_is_doing"
            android:ems="10"
            android:gravity="fill_vertical"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:labelFor="@+id/mainRecyclerView"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbarAlwaysDrawHorizontalTrack="false"
            android:scrollbarAlwaysDrawVerticalTrack="false"
            android:scrollbars="horizontal|vertical"
            android:selectAllOnFocus="false"
            android:singleLine="false"
            android:text="@string/name"
            android:textColor="#000000"
            android:textSize="12sp"
            tools:targetApi="o" />

        <Button
            android:id="@+id/button_backup_start"
            style="@android:style/Widget.Material.Light.Button.Borderless"
            android:layout_width="166dp"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="14dp"
            android:text="@string/upload"
            android:textAllCaps="true" tools:targetApi="lollipop" />

        <Button
            android:id="@+id/button_download_start"
            style="@android:style/Widget.Material.Light.Button.Borderless"
            android:layout_width="165dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/button_backup_start"
            android:layout_alignBottom="@+id/button_backup_start"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="12dp"
            android:text="@string/download"
            android:textAllCaps="true"
            tools:targetApi="lollipop" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="102dp"
            android:layout_height="101dp"
            android:layout_centerInParent="true" />

    </RelativeLayout>

</RelativeLayout>