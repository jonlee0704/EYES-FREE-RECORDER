<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- Top McIntosh Glass Header Bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Mode / Playback Icon Button (Hidden: gestures on dial control Play/Stop) -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Illuminated McIntosh Brand Title -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:shadowColor="#B300E676"
                android:shadowRadius="8"
                android:text="EYES-FREE RECORDER"
                android:textColor="@color/mcintosh_text_glass_green"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sub_brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.06"
                android:text="BY S&amp;D A11Y STUDIO"
                android:textColor="#3D6855"
                android:textSize="8.5sp" />
        </LinearLayout>



        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_mcintosh_circle_btn"
            android:contentDescription="Open Settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings_cyan_24dp" />

        <!-- TTS Status Pill -->
        <TextView
            android:id="@+id/progress_TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mcintosh_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="TTS ON"
            android:textColor="#00E5FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Highlighted Active Folder Capsule -->
    <LinearLayout
        android:id="@+id/center_display_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_mcintosh_center_folder"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <!-- Main Display / Center Active Folder in Signature McIntosh Green -->
        <TextView
            android:id="@+id/main_TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:enabled="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:linksClickable="false"
            android:longClickable="false"
            android:maxWidth="220dp"
            android:shadowColor="#B300E676"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:text="STANDBY"
            android:textColor="@color/mcintosh_green"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Detail Information Panel (Located below under the animation circle) -->
    <LinearLayout
        android:id="@+id/detail_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/gesture_hint_bar"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_mcintosh_detail_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="7dp"
        android:paddingEnd="18dp"
        android:paddingBottom="7dp">

        <!-- Detail Primary (Files count • Year • Storage) -->
        <TextView
            android:id="@+id/detail_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:maxWidth="320dp"
            android:text="INITIALIZING..."
            android:textColor="#00E676"
            android:textSize="11sp" />

        <!-- Detail Secondary (Folder Index • Location / Path) -->
        <TextView
            android:id="@+id/detail_secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:maxWidth="320dp"
            android:text=""
            android:textColor="#80B0C4DE"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Minimalist Gesture Hint Bar with Integrated Help '?' Button -->
    <LinearLayout
        android:id="@+id/gesture_hint_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/trackPos_TextView"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_mcintosh_gesture_bar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="7dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gesture_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="▶ 1x: PLAY/STOP   •   ● 2x: REC   •   ★ 3x: BOOKMARK"
                android:textColor="#60849B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/gesture_hint_swipe_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="◀▶ SWIPE: FILE   •   ▲▼ SWIPE: FOLDER   •   HOLD: SEEK"
                android:textColor="#50738A"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Subtle vertical separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:background="#2000E5FF" />

        <!-- Help '?' Button -->
        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_mcintosh_circle_btn"
            android:contentDescription="Gesture Instructions Help"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_help_cyan_24dp" />

    </LinearLayout>

    <!-- Bottom Readout (Track Position / Folder Counter) -->
    <TextView
        android:id="@+id/trackPos_TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="STANDBY"
        android:textColor="#00E676"
        android:textSize="12sp" />

</RelativeLayout>
